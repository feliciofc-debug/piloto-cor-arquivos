# PostgreSQL usado pelos scripts executados direto na VPS.
# Exemplo: cd api && npm run migrate
DATABASE_URL=postgresql://cor:troque_esta_senha@127.0.0.1:5434/piloto_cor

# Variáveis reais do serviço db.
POSTGRES_DB=piloto_cor
POSTGRES_USER=cor
POSTGRES_PASSWORD=troque_esta_senha

# PostgreSQL usado pela API dentro do container.
# Dentro do docker-compose, a API acessa o Postgres pelo nome do serviço: db.
DATABASE_URL_API=postgresql://cor:troque_esta_senha@db:5432/piloto_cor

JWT_SECRET=troque_por_um_valor_longo_aleatorio
COOKIE_NAME=cor_session

# Em produção com HTTPS, mantenha true para o cookie httpOnly seguro.
COOKIE_SECURE=true

DOMAIN=piloto.atombrasildigital.com
LETSENCRYPT_EMAIL=seu-email@dominio.com
NGINX_CLIENT_MAX_BODY_SIZE=100m

SESSION_TTL_SECONDS=43200
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

PORT=8091
HOST=0.0.0.0
